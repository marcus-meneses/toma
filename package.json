{
  "name": "toma",
  "version": "0.1.0",
  "description": "Tenant-scoped real-time invalidation service for Kahu.",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "APP_ENV=development tsx watch src/server.ts",
    "build": "tsc",
    "start": "APP_ENV=${APP_ENV:-production} node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "APP_ENV=test tsx --test test/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
